# Telegram bot token.
TELEGRAM_BOT_TOKEN=replace-me

# SQLite is persisted through the Docker volume mounted at /app/data.
DATABASE_URL=sqlite://data/dota2_bot_rust.db

OPEN_DOTA_BASE_URL=https://api.opendota.com/api
HTTP_TIMEOUT_SECS=10

# Public HTTPS origin for the Telegram Mini App. Telegram requires HTTPS.
# Leave empty until a public reverse-proxy domain is available.
WEB_APP_URL=

# Axum listener inside the process/container.
WEB_BIND=0.0.0.0:8080

# Host port for the local HTTPS reverse proxy.
WEB_PORT=8080

RUST_LOG=info
